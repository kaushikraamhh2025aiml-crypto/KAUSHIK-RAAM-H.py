import heapq

graph = {
    'A': [('B', 1), ('C', 4)],
    'B': [('D', 2), ('E', 5)],
    'C': [('F', 3)],
    'D': [],
    'E': [('F', 1)],
    'F': []
}

h = {'A': 5, 'B': 4, 'C': 2,
     'D': 3, 'E': 1, 'F': 0}

def greedy(start, goal):
    queue = [(h[start], start)]
    visited = set()

    while queue:
        _, node = heapq.heappop(queue)
        if node == goal:
            return node
        if node not in visited:
            visited.add(node)
            for child, cost in graph[node]:
                heapq.heappush(queue, (h[child], child))

def astar(start, goal):
    queue = [(h[start], 0, start)]
    visited = set()

    while queue:
        f, cost, node = heapq.heappop(queue)

        if node == goal:
            return cost

        if node not in visited:
            visited.add(node)
            for child, weight in graph[node]:
                new_cost = cost + weight
                heapq.heappush(
                    queue,
                    (new_cost + h[child], new_cost, child)
                )

print("Greedy Search:", greedy('A', 'F'))
print("A* Search Cost:", astar('A', 'F'))