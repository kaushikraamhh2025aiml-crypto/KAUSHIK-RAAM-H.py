def fuzzy_inference(value):

    if value <= 30:
        low = 1
    elif value <= 50:
        low = (50 - value) / 20
    else:
        low = 0

    if value <= 30 or value >= 70:
        medium = 0
    elif value <= 50:
        medium = (value - 30) / 20
    else:
        medium = (70 - value) / 20

    if value <= 50:
        high = 0
    elif value <= 70:
        high = (value - 50) / 20
    else:
        high = 1

    # Fuzzy rules
    if high > medium and high > low:
        result = "HIGH RISK"
    elif medium > low:
        result = "MEDIUM RISK"
    else:
        result = "LOW RISK"

    return result


