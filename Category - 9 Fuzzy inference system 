if choice in [1, 2, 3, 4] and 0 <= value <= 100:

    applications = {
        1: "Medical Diagnosis",
        2: "Electric Vehicle",
        3: "Autonomous Vehicle",
        4: "Smart Manufacturing"
    }

    print("\nApplication:", applications[choice])
    print("Input Value:", value)
    print("Fuzzy Result:", fuzzy_inference(value))

else:
