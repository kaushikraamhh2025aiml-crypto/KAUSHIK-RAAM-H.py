# Known vs Unknown
knowledge = True
print("Known Environment" if knowledge else "Unknown Environment")

# Static vs Dynamic
environment = "Dynamic"
print("Environment:", environment)

# Discrete vs Continuous
time = 5
print("Discrete Time:", time)

