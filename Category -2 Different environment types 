# Deterministic vs Stochastic
import random

print("Deterministic Result:", 10 + 5)
print("Stochastic Result:", random.randint(1, 6))

# Episodic vs Sequential
print("\nEpisodic: Each task is independent")
print("Sequential: Each action affects the next action")